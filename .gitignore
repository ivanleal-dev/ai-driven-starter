# .gitignore para monorepo .NET + Node + editor files

# Build outputs
**/bin/
**/obj/
**/out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / JetBrains
.idea/
*.sln.iml

# Dotnet user secrets
secrets.json
*.LocalDB

# EF Core snapshot/cache (keep migrations)
# Do NOT ignore Migrations folders - they are source

# ASP.NET temporary files
wwwroot/dist/
wwwroot/build/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.pnpm-debug.log

# Logs
logs/
*.log
npm-debug.log*
.yarn-integrity

# Runtime files
*.pid
*.seed
*.pid.lock

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Coverage
coverage/
coverage.*
*.lcov

# Test result files
TestResults/
*.trx

# IDE settings
.vscode/

# Environment files
.env
.env.*
local.env

# NuGet
*.nupkg
# The packages folder can be ignored because of PackageReference restore
**/packages/

# Rider caches
.idea/
*.sublime-workspace

# Docker
docker-compose.override.yml
.docker/

# Generated files
*.generated.cs

# Misc
*.bak
*.tmp
*~

# Ensure Migrations are not ignored if you have a Migrations folder
!**/Migrations/**

# Ignore user-specific publish profiles
**/Properties/launchSettings.json

# Optional: Visual Studio Code workspace
*.code-workspace

# End of .gitignore

/docs
